{
  "name": "sqids-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Generate short unique IDs from numbers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdhthahmd/sqids.git"
  },
  "type": "module",
  "scripts": {
    "benchmark": "pnpm --dir lib benchmark",
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean",
    "dev": "pnpm --dir lib dev",
    "start:dev": "pnpm --parallel --filter './examples/*' start:dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "check": "pnpm lint:fix && pnpm format",
    "check:ci": "pnpm lint && pnpm format:check",
    "test": "pnpm test:all",
    "test:code": "pnpm -r --if-present test:code",
    "test:coverage": "pnpm --dir lib test:coverage",
    "test:types": "pnpm -r --if-present test:types",
    "test:package": "pnpm --dir lib test:package",
    "test:all": "pnpm build && pnpm test:types && pnpm test:code && pnpm check:ci",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "semantic-release": "^25.0.9"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,yaml,yml,toml,html,htm,vue,svelte,astro,css,scss,less,md,markdown,mdx,graphql,gql,hbs,handlebars}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  }
}
