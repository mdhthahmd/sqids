{
	"name": "@sqids-examples/nestjs-api",
	"private": true,
	"type": "commonjs",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf dist",
		"start": "node dist/src/main.js",
		"dev": "tsx watch src/main.ts",
		"test": "pnpm build && pnpm test:code",
		"test:code": "node --test dist/test/*.test.js",
		"test:types": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@mdhthahmd/sqids": "2.1.3",
		"@nestjs/common": "11.2.1",
		"@nestjs/core": "11.2.1",
		"@nestjs/platform-express": "11.2.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@nestjs/testing": "11.2.1",
		"@types/node": "^24.0.0",
		"@types/supertest": "^6.0.3",
		"supertest": "^7.1.4",
		"tsx": "^4.20.0",
		"typescript": "7.0.2"
	}
}
