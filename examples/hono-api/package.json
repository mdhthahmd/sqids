{
	"name": "@sqids-examples/hono-api",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf dist",
		"start": "node dist/src/index.js",
		"dev": "tsx watch src/index.ts",
		"test": "pnpm build && pnpm test:code",
		"test:code": "node --test dist/test/*.test.js",
		"test:types": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@hono/node-server": "2.1.1",
		"@mdhthahmd/sqids": "2.1.3",
		"hono": "4.13.3"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tsx": "^4.20.0",
		"typescript": "7.0.2"
	}
}
